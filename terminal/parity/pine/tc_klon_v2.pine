//@version=5
// TC Klon v2 — Trader Club BUY-SELL + S/R göstergelerinin yeniden yazımı (taslak, 28.10.2026)
// Kaynak: TradingView ekran ölçümleri + Binance verisiyle doğrulama (bkz. Takip.md §13).
// Durum: Buy/Sell = Range Filter (ohlc4, periyot 50, çarpan 0.7+0.5×Sensitivity): BREV 1m'de s1 12/12, s3 3/3+7/7, s6 3/3; Reversal Bands orta çizgi birebir, adım yaklaşık;
//        S/R basitleştirilmiş (pivot 10 + %2 bölge + güç 2). Ribbon = SMA(ohlc4,5/8). Mild X = WaveTrend(9,12,4) kesişmesi ±53. ▲▼ = WaveTrend(9,12,3) fraktal uyumsuzluğu. Reversal ◇ henüz yok.
indicator("TC Klon v2", shorttitle = "TC Klon v2", overlay = true, format = format.price, precision = 6, max_lines_count = 100, max_boxes_count = 100, max_labels_count = 200)

// ───── Girdiler ─────
grpBS  = "Buy / Sell (Range Filter)"
rfLen  = input.int(50, "Periyot", minval = 2, group = grpBS)
sens   = input.int(3, "Sensitivity (1-6)", minval = 1, maxval = 6, group = grpBS)
rfMult = 0.7 + 0.5 * sens  // ölçüm 28.10: s1→1.15–1.35, s3→2.0–2.35, s6→3.65–3.7
showBS = input.bool(true, "Buy/Sell etiketleri", group = grpBS)
slPct  = input.float(1.0, "Stop Loss %", step = 0.1, group = grpBS)
showTP = input.bool(true, "TP/SL çizgileri", group = grpBS)

grpMX  = "Mild Buy/Sell (X)"
showMX = input.bool(true, "X işaretleri", group = grpMX)
mxN1   = input.int(9, "WaveTrend kanal", group = grpMX)
mxN2   = input.int(12, "WaveTrend ortalama", group = grpMX)
mxSig  = input.int(4, "Sinyal (SMA)", group = grpMX)
mxLvl  = input.float(53, "Bölge (±)", group = grpMX)

grpDV  = "Divergence (▲▼)"
showDV = input.bool(true, "▲▼ işaretleri", group = grpDV)
dvN1   = input.int(9, "WaveTrend kanal", group = grpDV)
dvN2   = input.int(12, "WaveTrend ortalama", group = grpDV)
dvSig  = input.int(3, "Sinyal (SMA)", group = grpDV)
dvTop  = input.float(20, "Tepe en az", group = grpDV)
dvBot  = input.float(-40, "Dip en çok", group = grpDV)

grpRI  = "Ribbon"
showRI = input.bool(true, "Ribbon göster", group = grpRI)
riFast = input.int(5, "Hızlı (SMA ohlc4)", group = grpRI)
riSlow = input.int(8, "Yavaş (SMA ohlc4)", group = grpRI)

grpRB  = "Reversal Bands"
showRB = input.bool(true, "Bantları göster", group = grpRB)
rbLen  = input.int(30, "Orta çizgi uzunluğu (SMA ohlc4)", group = grpRB)
rbWLen = input.int(48, "Adım uzunluğu (WMA high-low)", group = grpRB)
rbWMul = input.float(1.12, "Adım çarpanı (yaklaşık)", step = 0.01, group = grpRB)

grpSR  = "S/R"
showSR = input.bool(true, "S/R bölgeleri", group = grpSR)
pvLen  = input.int(10, "Pivot (sol/sağ mum)", group = grpSR)
zonePc = input.float(2.0, "Bölge genişliği % (300 mum aralığının)", step = 0.1, group = grpSR)
minStr = input.int(2, "En az güç (pivot sayısı)", group = grpSR)
maxSR  = input.int(6, "En fazla seviye", group = grpSR)

// ───── Buy / Sell: Range Filter ─────
src = ohlc4  // 28.10 21:40: BREV 1m + BULLA 5m, 27 etiket → ohlc4 27/27 (hlc3 24/27)
absChg = math.abs(src - nz(src[1], src))
smRange = ta.ema(ta.ema(absChg, rfLen), rfLen * 2 - 1) * rfMult
var float filt = na
prevF = nz(filt[1], src)
filt := src > prevF ? (src - smRange < prevF ? prevF : src - smRange) : (src + smRange > prevF ? prevF : src + smRange)
var int upCnt = 0
var int dnCnt = 0
upCnt := filt > filt[1] ? upCnt + 1 : filt < filt[1] ? 0 : upCnt
dnCnt := filt < filt[1] ? dnCnt + 1 : filt > filt[1] ? 0 : dnCnt
// Orijinal Range Filter (DonovanWall) yazımı: src == src[1] iken koşul oluşmaz
longC  = src > filt and src != src[1] and upCnt > 0
shortC = src < filt and src != src[1] and dnCnt > 0
var int state = 0
prevState = state
state := longC ? 1 : shortC ? -1 : state
buySig  = longC and prevState == -1
sellSig = shortC and prevState == 1

plotshape(showBS and buySig, "Buy", shape.labelup, location.belowbar, color.new(#00e5ff, 0), text = "Buy", textcolor = color.black, size = size.small)
plotshape(showBS and sellSig, "Sell", shape.labeldown, location.abovebar, color.new(#f6465d, 0), text = "Sell", textcolor = color.white, size = size.small)
barcolor(state == 1 ? #00e5ff : state == -1 ? #f6465d : na)
// Hata ayıklama: Range Filter iç değerleri (grafikte çizilmez, sadece üst satırda/veri penceresinde görünür)
plot(filt, "RF filtre", color.orange, display = display.status_line + display.data_window)
plot(smRange, "RF aralık", color.gray, display = display.status_line + display.data_window)
plot(upCnt, "RF yukarı sayaç", color.teal, display = display.status_line + display.data_window)
plot(src, "RF kaynak (ohlc4)", color.white, display = display.status_line + display.data_window)

// TP/SL: giriş = sinyal mumunun kapanışı, SL %slPct, TP %1/%2/%3 — orijinal gibi fiyat etiketleriyle
var float entry = na
var int dirTP = 0
var int sigBar = na
if buySig or sellSig
    entry := close
    dirTP := buySig ? 1 : -1
    sigBar := bar_index
lvl(float p) => entry * (1 + dirTP * p / 100)
drawLvl(float price, string txt, color col, line[] ls, label[] lbs, int x1) =>
    array.push(ls, line.new(x1, price, bar_index + 12, price, color = col, width = 1))
    array.push(lbs, label.new(bar_index + 12, price, txt + ": " + str.tostring(price, format.mintick), style = label.style_label_left, color = col, textcolor = color.white, size = size.small))
var line[] tpLines = array.new_line()
var label[] tpLabels = array.new_label()
if showTP and barstate.islast and not na(entry)
    for l in tpLines
        line.delete(l)
    for b in tpLabels
        label.delete(b)
    array.clear(tpLines)
    array.clear(tpLabels)
    drawLvl(entry, "Entry", color.gray, tpLines, tpLabels, sigBar)
    drawLvl(lvl(-slPct), "Stop Loss", color.new(#f6465d, 0), tpLines, tpLabels, sigBar)
    for k = 1 to 3
        drawLvl(lvl(k), "Take Profit " + str.tostring(k), color.new(#2e9e5b, 0), tpLines, tpLabels, sigBar)

// ───── Mild Buy/Sell (X) = WaveTrend kesişmesi aşırı bölgede ─────
// BREV 1m, 18 gözlem (27–28.10, ~7 saat): 17/18 bulundu (16 tam mum), fazladan 0. WT(9,12,4) ±53.
mxAp  = hlc3
mxEsa = ta.ema(mxAp, mxN1)
mxD   = ta.ema(math.abs(mxAp - mxEsa), mxN1)
mxCi  = (mxAp - mxEsa) / (0.015 * mxD)
wt1   = ta.ema(mxCi, mxN2)
wt2   = ta.sma(wt1, mxSig)
mildBuy  = ta.crossover(wt1, wt2) and wt2 < -mxLvl
mildSell = ta.crossunder(wt1, wt2) and wt2 > mxLvl
plotshape(showMX and mildBuy, "Mild Buy", shape.xcross, location.belowbar, color.new(#00e5ff, 0), size = size.tiny)
plotshape(showMX and mildSell, "Mild Sell", shape.xcross, location.abovebar, color.new(#f6465d, 0), size = size.tiny)

// ───── Divergence ▲▼ = WaveTrend (wt2) tepe/dip uyumsuzluğu ─────
// 7 mumluk fraktal (3 sol / 3 sağ). Fiyat daha yüksek tepe + wt2 daha düşük tepe → ▼; fiyat daha düşük dip + wt2 daha yüksek dip → ▲.
// BREV 1m, 9 gözlem (27–28.10): 8/9 bulundu, ~9 saatte fazladan 0 işaret. Fraktal 3 mum sonra onaylanır; işaret 1 mum geri çizilir.
dvEsa = ta.ema(hlc3, dvN1)
dvD   = ta.ema(math.abs(hlc3 - dvEsa), dvN1)
dvW1  = ta.ema((hlc3 - dvEsa) / (0.015 * dvD), dvN2)
dvW2  = ta.sma(dvW1, dvSig)
isTop = dvW2[3] > dvW2[2] and dvW2[3] > dvW2[1] and dvW2[3] > dvW2 and dvW2[3] > dvW2[4] and dvW2[3] > dvW2[5] and dvW2[3] > dvW2[6]
isBot = dvW2[3] < dvW2[2] and dvW2[3] < dvW2[1] and dvW2[3] < dvW2 and dvW2[3] < dvW2[4] and dvW2[3] < dvW2[5] and dvW2[3] < dvW2[6]
var float pTopO = na
var float pTopH = na
var float pBotO = na
var float pBotL = na
bearDiv = false
bullDiv = false
if isTop and dvW2[3] >= dvTop
    bearDiv := not na(pTopO) and high[3] > pTopH and dvW2[3] < pTopO
    pTopO := dvW2[3]
    pTopH := high[3]
if isBot and dvW2[3] <= dvBot
    bullDiv := not na(pBotO) and low[3] < pBotL and dvW2[3] > pBotO
    pBotO := dvW2[3]
    pBotL := low[3]
plotshape(showDV and bullDiv, "Divergence ▲", shape.triangleup, location.belowbar, color.new(#00e5ff, 0), offset = -1, size = size.tiny)
plotshape(showDV and bearDiv, "Divergence ▼", shape.triangledown, location.abovebar, color.new(#f6465d, 0), offset = -1, size = size.tiny)

// ───── Ribbon: SMA(ohlc4,5) / SMA(ohlc4,8) — BREV 1m 4 ölçümde ekrandaki değerlerle yuvarlama payı içinde (28.10) ─────
riF = ta.sma(ohlc4, riFast)
riS = ta.sma(ohlc4, riSlow)
pF = plot(showRI ? riF : na, "Ribbon hızlı", color.new(#2962ff, 0))
pS = plot(showRI ? riS : na, "Ribbon yavaş", color.new(#2962ff, 30))
fill(pF, pS, riF >= riS ? color.new(#00e5ff, 70) : color.new(#f6465d, 70), "Ribbon dolgu")

// ───── Reversal Bands ─────
rbMid  = ta.sma(ohlc4, rbLen)
rbStep = ta.wma(high - low, rbWLen) * rbWMul
plot(showRB ? rbMid + 3 * rbStep : na, "Üst 1", color.new(#f6465d, 40))
plot(showRB ? rbMid + 4 * rbStep : na, "Üst 2", color.new(#f6465d, 55))
plot(showRB ? rbMid + 5 * rbStep : na, "Üst 3", color.new(#f6465d, 70))
plot(showRB ? rbMid + 6 * rbStep : na, "Üst 4", color.new(#f6465d, 80))
plot(showRB ? rbMid - 3 * rbStep : na, "Alt 1", color.new(#00e5ff, 40))
plot(showRB ? rbMid - 4 * rbStep : na, "Alt 2", color.new(#00e5ff, 55))
plot(showRB ? rbMid - 5 * rbStep : na, "Alt 3", color.new(#00e5ff, 70))
plot(showRB ? rbMid - 6 * rbStep : na, "Alt 4", color.new(#00e5ff, 80))

// ───── S/R: pivotları %zonePc genişlikli bölgelerde topla ─────
ph = ta.pivothigh(high, pvLen, pvLen)
pl = ta.pivotlow(low, pvLen, pvLen)
var float[] pivots = array.new_float()
if not na(ph)
    array.unshift(pivots, ph)
if not na(pl)
    array.unshift(pivots, pl)
if array.size(pivots) > 40
    array.pop(pivots)
var box[] boxes = array.new_box()
if showSR and barstate.islast
    for b in boxes
        box.delete(b)
    array.clear(boxes)
    width = (ta.highest(high, 300) - ta.lowest(low, 300)) * zonePc / 100
    used = array.new_bool(array.size(pivots), false)
    drawn = 0
    for i = 0 to array.size(pivots) - 1
        if drawn >= maxSR
            break
        if array.get(used, i)
            continue
        lo = array.get(pivots, i)
        hi = lo
        cnt = 0
        for j = 0 to array.size(pivots) - 1
            p = array.get(pivots, j)
            if math.max(hi, p) - math.min(lo, p) <= width
                lo := math.min(lo, p)
                hi := math.max(hi, p)
                cnt += 1
                array.set(used, j, true)
        if cnt >= minStr
            colr = close > hi ? color.new(#00e5ff, 75) : color.new(#f6465d, 75)
            array.push(boxes, box.new(bar_index - 300, hi, bar_index + 30, lo, border_color = colr, bgcolor = colr))
            drawn += 1
