//@version=5
indicator("REA-Trader Club BUY-SELL [V.1]", shorttitle="REA-TC Buy-Sell", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ==============================================================================
// 1. INPUTS & AYARLAR (VARSAYILAN TEMİZ GÖRÜNÜM)
// ==============================================================================

// --- ANA SİNYAL AYARLARI ---
grp_main        = "=== ANA AL/SAT SİNYAL AYARLARI ==="
show_buy_sell   = input.bool(true,  "Al / Sat Sinyallerini Göster", group=grp_main)
sensitivity     = input.float(3.0,  "Hassasiyet (Sensitivity)", minval=0.1, step=0.1, group=grp_main)
offset_signal   = input.float(2.0,  "Sinyal Etiket Mesafesi %", minval=0.5, step=0.5, group=grp_main)
color_bars      = input.bool(true,  "Mumları Trend Rengine Göre Boya", group=grp_main)

// --- TP / SL RİSK SEVİYELERİ ---
grp_tpsl        = "=== TP / SL (RİSK YÖNETİMİ) ==="
percent_stop    = input.float(1.0,  "Stop Loss % (0 = Kapat)", minval=0.0, step=0.1, group=grp_tpsl)
show_tpsl_lines = input.bool(true,  "Giriş, Stop ve TP Çizgilerini Göster", group=grp_tpsl)

// --- RIBBON AYARLARI ---
grp_ribbon      = "=== HAREKETLİ ORTALAMA RIBBON ==="
show_ribbon     = input.bool(true,  "Ribbon Göster", group=grp_ribbon)
smooth1         = input.int(5,      "Hızlı SMA (Smooth 1)", minval=1, group=grp_ribbon)
smooth2         = input.int(8,      "Yavaş SMA (Smooth 2)", minval=1, group=grp_ribbon)

// --- REVERSAL & WAVETREND ---
grp_rev         = "=== DÖNÜŞ & WAVETREND SİNYALLERİ ==="
show_reversal   = input.bool(true,  "RSI Dönüş Elmasları (Reversal)", group=grp_rev)
show_wt_mild    = input.bool(true,  "WaveTrend Hafif Al/Sat Haçları (+)", group=grp_rev)
show_wt_div     = input.bool(true,  "WaveTrend Uyumsuzluk Okları (▲/▼)", group=grp_rev)

// --- DÖNÜŞ BANTLARI (REVERSAL BANDS - ÖLÇEK BOZMAMASI İÇİN VARSAYILAN KAPALI) ---
grp_bands       = "=== DÖNÜŞ BANTLARI (REVERSAL BANDS) ==="
show_rev_bands  = input.bool(false, "Reversal Bantlarını Göster (ATR 3-6x)", tooltip="Açıldığında fiyat ölçeğini genişletebilir.", group=grp_bands)
len_rev_bands   = input.int(30,     "Bant Periyodu", minval=5, group=grp_bands)

// --- PREVIOUS DAY H/L/C ---
grp_pd          = "=== ÖNCEKİ GÜN SEVİYELERİ (P.D. H/L/C) ==="
show_pd_hlc     = input.bool(false, "Önceki Gün High, Low, Close Göster", group=grp_pd)

// --- EMA ÇİZGİLERİ ---
grp_emas        = "=== TREND EMA'LARI ==="
show_emas       = input.bool(false, "EMA Çizgilerini Göster", group=grp_emas)
len_ema1        = input.int(7,      "EMA 1 Periyot", minval=1, group=grp_emas)
len_ema2        = input.int(21,     "EMA 2 Periyot", minval=1, group=grp_emas)
len_ema3        = input.int(144,    "EMA 3 Periyot", minval=1, group=grp_emas)

// --- PİYASA YAPISI (SWING POINTS) ---
grp_swing       = "=== MARKET STRUCTURE (HH, HL, LH, LL) ==="
show_swing      = input.bool(false, "Piyasa Yapısı Noktalarını Göster", group=grp_swing)
prd_swing       = input.int(10,     "Swing Pivot Periyodu", minval=2, group=grp_swing)

// --- DASHBOARD (TABLO) ---
grp_dash        = "=== ÇOKLU ZAMAN DİLİMİ TABLOSU ==="
show_dashboard  = input.bool(true,  "Trend Dashboard Tablosunu Göster", group=grp_dash)
table_pos       = input.string("Middle Right", "Tablo Konumu", options=["Top Right", "Middle Right", "Bottom Right", "Top Left", "Middle Left", "Bottom Left"], group=grp_dash)

// --- RENK PALETİ ---
cyan       = #00DBFF
pink       = #E91E63
cyan_fill  = color.new(#00DBFF, 85)
pink_fill  = color.new(#E91E63, 85)
red_fill   = color.new(#FF5252, 85)
col_green  = #22C55E
col_red    = #EF4444


// ==============================================================================
// 2. RANGE FILTER FONKSİYONLARI VE ALGORİTMASI
// ==============================================================================
f_smoothrng(src, len, mult) =>
    wper = math.max(1, len * 2 - 1)
    avrng = ta.ema(math.abs(src - src[1]), math.max(1, len))
    ta.ema(avrng, wper) * mult

f_rngfilt(src, r) =>
    var float f = na
    f := na(f[1]) ? src : src > f[1] ? (src - r < f[1] ? f[1] : src - r) : (src + r > f[1] ? f[1] : src + r)
    f

// İkili Range Filter (Twin Range Filter)
smrng1 = f_smoothrng(close, 27, 1.5)
smrng2 = f_smoothrng(close, 55, sensitivity)
smrng  = (smrng1 + smrng2) / 2.0
filt   = f_rngfilt(close, smrng)

// Yükseliş / Düşüş Sayacı
var float up_cnt = 0.0
var float dn_cnt = 0.0

if filt > filt[1]
    up_cnt := up_cnt[1] + 1.0
    dn_cnt := 0.0
else if filt < filt[1]
    dn_cnt := dn_cnt[1] + 1.0
    up_cnt := 0.0
else
    up_cnt := up_cnt[1]
    dn_cnt := dn_cnt[1]

bull_cond = (close > filt) and (up_cnt > 0)
bear_cond = (close < filt) and (dn_cnt > 0)

var int last_cond = 0
if bull_cond
    last_cond := 1
else if bear_cond
    last_cond := -1

bull = bull_cond and (last_cond[1] == -1)
bear = bear_cond and (last_cond[1] == 1)

// Mum Renklendirme
bar_col = up_cnt > dn_cnt ? cyan : pink
barcolor(color_bars ? bar_col : na)

// Sinyal Etiketleri (Küçük ve zarif)
perc_off = (ta.highest(high, 50) - ta.lowest(low, 50)) * (offset_signal / 100.0)
plotshape(show_buy_sell and bull ? (low - perc_off) : na, title="Buy Signal", style=shape.labelup, location=location.absolute, color=cyan, text="Buy", textcolor=color.black, size=size.tiny)
plotshape(show_buy_sell and bear ? (high + perc_off) : na, title="Sell Signal", style=shape.labeldown, location=location.absolute, color=pink, text="Sell", textcolor=color.white, size=size.tiny)


// ==============================================================================
// 3. RIBBON (FAST/SLOW SMA KOMBİNASYONU)
// ==============================================================================
ribbon1 = ta.sma(close, smooth1)
ribbon2 = ta.sma(close, smooth2)

p_rib1 = plot(show_ribbon ? ribbon1 : na, title="Ribbon Fast", color=color.new(color.white, 100))
p_rib2 = plot(show_ribbon ? ribbon2 : na, title="Ribbon Slow", color=color.new(color.white, 100))
fill(p_rib1, p_rib2, color=show_ribbon ? (ribbon1 >= ribbon2 ? cyan_fill : pink_fill) : na, title="Ribbon Fill")


// ==============================================================================
// 4. REVERSAL & WAVETREND SİNYALLERİ (TEKİL TETİKLEME İLE ELMAS DUVARINI ÖNLEME)
// ==============================================================================
// RSI Dönüş Elmasları (Sadece kesişim anında tek elmas basar, ardışık dizilmez)
rsi_21   = ta.rsi(close, 21)
rsi_avg  = ta.ema(rsi_21, 10)
rsi_ob_c = ta.crossunder(rsi_21, rsi_avg) and (rsi_21 > 65)
rsi_os_c = ta.crossover(rsi_21, rsi_avg)  and (rsi_21 < 35)

plotshape(show_reversal and rsi_os_c ? low : na,  title="Reversal Buy",  style=shape.diamond, location=location.belowbar, color=cyan, size=size.tiny)
plotshape(show_reversal and rsi_ob_c ? high : na, title="Reversal Sell", style=shape.diamond, location=location.abovebar, color=pink, size=size.tiny)

// WaveTrend Algoritması
f_wavetrend(src, ch_len, avg_len) =>
    esa = ta.ema(src, ch_len)
    dev = ta.ema(math.abs(src - esa), ch_len)
    ci  = (src - esa) / (0.015 * dev)
    wt1 = ta.ema(ci, avg_len)
    wt2 = ta.sma(wt1, 3)
    [wt1, wt2]

[wt1, wt2] = f_wavetrend(hlc3, 9, 12)

// Hafif Al/Sat Haçları (+)
wt_mild_buy  = ta.crossover(wt1, wt2) and (wt2 <= -53)
wt_mild_sell = ta.crossunder(wt1, wt2) and (wt2 >= 53)
plotshape(show_wt_mild and wt_mild_buy ? low : na,   title="Mild Buy (+)",  style=shape.cross, location=location.belowbar, color=cyan, size=size.tiny)
plotshape(show_wt_mild and wt_mild_sell ? high : na, title="Mild Sell (+)", style=shape.cross, location=location.abovebar, color=pink, size=size.tiny)

// WaveTrend Divergence (Uyumsuzluk) Sinyalleri
wt_div_bull = (wt2 < -40) and (ta.pivotlow(wt2, 2, 2) > ta.pivotlow(wt2[5], 2, 2)) and (ta.pivotlow(low, 2, 2) < ta.pivotlow(low[5], 2, 2))
wt_div_bear = (wt2 > 40)  and (ta.pivothigh(wt2, 2, 2) < ta.pivothigh(wt2[5], 2, 2)) and (ta.pivothigh(high, 2, 2) > ta.pivothigh(high[5], 2, 2))
plotshape(show_wt_div and wt_div_bull ? low : na,  title="WT Divergence Buy",  style=shape.triangleup,   location=location.belowbar, color=cyan, size=size.small)
plotshape(show_wt_div and wt_div_bear ? high : na, title="WT Divergence Sell", style=shape.triangledown, location=location.abovebar, color=pink, size=size.small)


// ==============================================================================
// 5. REVERSAL BANDS (DÖNÜŞ BANTLARI)
// ==============================================================================
if show_rev_bands
    basis_rev = ta.sma(close, len_rev_bands)
    atr_rev   = ta.atr(len_rev_bands)
    plot(basis_rev + atr_rev * 6, title="Rev. Upper 4", color=red_fill, linewidth=1)
    plot(basis_rev + atr_rev * 5, title="Rev. Upper 3", color=red_fill, linewidth=1)
    plot(basis_rev + atr_rev * 4, title="Rev. Upper 2", color=red_fill, linewidth=1)
    plot(basis_rev + atr_rev * 3, title="Rev. Upper 1", color=red_fill, linewidth=1)
    plot(basis_rev - atr_rev * 3, title="Rev. Lower 1", color=cyan_fill, linewidth=1)
    plot(basis_rev - atr_rev * 4, title="Rev. Lower 2", color=cyan_fill, linewidth=1)
    plot(basis_rev - atr_rev * 5, title="Rev. Lower 3", color=cyan_fill, linewidth=1)
    plot(basis_rev - atr_rev * 6, title="Rev. Lower 4", color=cyan_fill, linewidth=1)


// ==============================================================================
// 6. TP / SL RİSK SEVİYELERİ (SADECE SON AKTİF SİNYAL İÇİN ÇİZİLİR)
// ==============================================================================
var line line_entry = na
var line line_sl    = na
var line line_tp1   = na
var line line_tp2   = na

var label lbl_entry = na
var label lbl_sl    = na
var label lbl_tp1   = na
var label lbl_tp2   = na

if show_tpsl_lines and (bull or bear) and percent_stop > 0
    line.delete(line_entry)
    line.delete(line_sl)
    line.delete(line_tp1)
    line.delete(line_tp2)
    label.delete(lbl_entry)
    label.delete(lbl_sl)
    label.delete(lbl_tp1)
    label.delete(lbl_tp2)

    float entry_price = close
    bool  is_long     = bull
    float sl_price    = is_long ? entry_price * (1.0 - percent_stop / 100.0) : entry_price * (1.0 + percent_stop / 100.0)
    float risk_diff   = math.abs(entry_price - sl_price)
    float tp1_price   = is_long ? entry_price + risk_diff       : entry_price - risk_diff
    float tp2_price   = is_long ? entry_price + 2.0 * risk_diff : entry_price - 2.0 * risk_diff

    int x1 = bar_index
    int x2 = bar_index + 20

    line_entry := line.new(x1, entry_price, x2, entry_price, color=color.gray, width=1)
    line_sl    := line.new(x1, sl_price,    x2, sl_price,    color=col_red,    width=1)
    line_tp1   := line.new(x1, tp1_price,   x2, tp1_price,   color=col_green,  width=1)
    line_tp2   := line.new(x1, tp2_price,   x2, tp2_price,   color=col_green,  width=1)

    lbl_entry  := label.new(x2, entry_price, "Giriş: " + str.tostring(entry_price, "#.####"), style=label.style_label_left, color=color.gray, textcolor=color.white, size=size.tiny)
    lbl_sl     := label.new(x2, sl_price,    "Stop: "  + str.tostring(sl_price, "#.####"),  style=label.style_label_left, color=col_red, textcolor=color.white, size=size.tiny)
    lbl_tp1    := label.new(x2, tp1_price,   "TP 1: "  + str.tostring(tp1_price, "#.####"), style=label.style_label_left, color=col_green, textcolor=color.white, size=size.tiny)
    lbl_tp2    := label.new(x2, tp2_price,   "TP 2: "  + str.tostring(tp2_price, "#.####"), style=label.style_label_left, color=col_green, textcolor=color.white, size=size.tiny)


// ==============================================================================
// 7. PREVIOUS DAY H/L/C & EMA'LAR (OPSİYONEL)
// ==============================================================================
if show_pd_hlc
    pd_high  = request.security(syminfo.tickerid, "1D", high[1],  gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
    pd_low   = request.security(syminfo.tickerid, "1D", low[1],   gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
    pd_close = request.security(syminfo.tickerid, "1D", close[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
    plot(pd_high,  title="P.D.H", color=#FACC15, linewidth=1, style=plot.style_circles)
    plot(pd_low,   title="P.D.L", color=#FACC15, linewidth=1, style=plot.style_circles)
    plot(pd_close, title="P.D.C", color=#FACC15, linewidth=1, style=plot.style_circles)

if show_emas
    plot(ta.ema(close, len_ema1), title="EMA 1 (7)",   color=#22C55E, linewidth=2)
    plot(ta.ema(close, len_ema2), title="EMA 2 (21)",  color=#A855F7, linewidth=2)
    plot(ta.ema(close, len_ema3), title="EMA 3 (144)", color=#EAB308, linewidth=2)


// ==============================================================================
// 8. PİYASA YAPISI (HH, HL, LH, LL)
// ==============================================================================
if show_swing
    ph_sw = ta.pivothigh(high, prd_swing, prd_swing)
    pl_sw = ta.pivotlow(low, prd_swing, prd_swing)
    var float last_hi = na
    var float last_lo = na
    if not na(ph_sw)
        if not na(last_hi) and ph_sw > last_hi
            label.new(bar_index - prd_swing, ph_sw, "HH", color=color.new(col_green, 40), textcolor=color.white, style=label.style_label_down, size=size.tiny)
        else if not na(last_hi) and ph_sw < last_hi
            label.new(bar_index - prd_swing, ph_sw, "LH", color=color.new(col_red, 40), textcolor=color.white, style=label.style_label_down, size=size.tiny)
        last_hi := ph_sw
    if not na(pl_sw)
        if not na(last_lo) and pl_sw > last_lo
            label.new(bar_index - prd_swing, pl_sw, "HL", color=color.new(col_green, 40), textcolor=color.white, style=label.style_label_up, size=size.tiny)
        else if not na(last_lo) and pl_sw < last_lo
            label.new(bar_index - prd_swing, pl_sw, "LL", color=color.new(col_red, 40), textcolor=color.white, style=label.style_label_up, size=size.tiny)
        last_lo := pl_sw


// ==============================================================================
// 9. ÇOKLU ZAMAN DİLİMİ (MTF) TREND DASHBOARD
// ==============================================================================
tf1_bull   = request.security(syminfo.tickerid, "1",    close > ta.ema(close, 144), gaps=barmerge.gaps_off)
tf3_bull   = request.security(syminfo.tickerid, "3",    close > ta.ema(close, 144), gaps=barmerge.gaps_off)
tf5_bull   = request.security(syminfo.tickerid, "5",    close > ta.ema(close, 144), gaps=barmerge.gaps_off)
tf15_bull  = request.security(syminfo.tickerid, "15",   close > ta.ema(close, 144), gaps=barmerge.gaps_off)
tf30_bull  = request.security(syminfo.tickerid, "30",   close > ta.ema(close, 144), gaps=barmerge.gaps_off)
tf60_bull  = request.security(syminfo.tickerid, "60",   close > ta.ema(close, 144), gaps=barmerge.gaps_off)
tf120_bull = request.security(syminfo.tickerid, "120",  close > ta.ema(close, 144), gaps=barmerge.gaps_off)
tf240_bull = request.security(syminfo.tickerid, "240",  close > ta.ema(close, 144), gaps=barmerge.gaps_off)
tf480_bull = request.security(syminfo.tickerid, "480",  close > ta.ema(close, 144), gaps=barmerge.gaps_off)
tfD_bull   = request.security(syminfo.tickerid, "1D",   close > ta.ema(close, 144), gaps=barmerge.gaps_off)

if show_dashboard and barstate.islast
    string pos_str = table_pos == "Top Right" ? position.top_right : table_pos == "Bottom Right" ? position.bottom_right : table_pos == "Top Left" ? position.top_left : table_pos == "Middle Left" ? position.middle_left : table_pos == "Bottom Left" ? position.bottom_left : position.middle_right
    var table dash = table.new(pos_str, 2, 15, bgcolor=#2A2A2A, border_color=#373A46, border_width=1)

    bool cur_pos_buy = last_cond == 1
    bool cur_trend_bull = close > ta.ema(close, 144)

    table.cell(dash, 0, 0, "Trader Club", text_color=color.white, bgcolor=#1E222D, text_size=size.small)
    table.cell(dash, 1, 0, "V.1", text_color=color.white, bgcolor=#1E222D, text_size=size.small)

    table.cell(dash, 0, 1, "Current Position", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, cur_pos_buy ? "Buy" : "Sell", bgcolor=cur_pos_buy ? col_green : col_red, text_color=color.black, text_size=size.small)

    table.cell(dash, 0, 2, "Current Trend", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, cur_trend_bull ? "Bullish" : "Bearish", bgcolor=cur_trend_bull ? col_green : col_red, text_color=color.black, text_size=size.small)

    table.cell(dash, 0, 3, "Volume", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(volume, "#"), text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 4, "Timeframe", text_color=color.gray, bgcolor=#1E222D, text_size=size.small)
    table.cell(dash, 1, 4, "Trends", text_color=color.gray, bgcolor=#1E222D, text_size=size.small)

    string[] tf_names = array.new_string()
    array.push(tf_names, "1 min:")
    array.push(tf_names, "3 min:")
    array.push(tf_names, "5 min:")
    array.push(tf_names, "15 min:")
    array.push(tf_names, "30 min:")
    array.push(tf_names, "1 H:")
    array.push(tf_names, "2 H:")
    array.push(tf_names, "4 H:")
    array.push(tf_names, "8 H:")
    array.push(tf_names, "Daily:")

    bool[] tf_bulls = array.new_bool()
    array.push(tf_bulls, tf1_bull)
    array.push(tf_bulls, tf3_bull)
    array.push(tf_bulls, tf5_bull)
    array.push(tf_bulls, tf15_bull)
    array.push(tf_bulls, tf30_bull)
    array.push(tf_bulls, tf60_bull)
    array.push(tf_bulls, tf120_bull)
    array.push(tf_bulls, tf240_bull)
    array.push(tf_bulls, tf480_bull)
    array.push(tf_bulls, tfD_bull)

    for r = 0 to 9
        bool b = array.get(tf_bulls, r)
        table.cell(dash, 0, r + 5, array.get(tf_names, r), text_color=color.white, text_size=size.small)
        table.cell(dash, 1, r + 5, b ? "Bullish" : "Bearish", bgcolor=b ? col_green : col_red, text_color=color.black, text_size=size.small)
